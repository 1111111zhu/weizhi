    },
    {
      "path": "apps/emp/src/components",
      "scope": "emp",
      "kind": "application-component"
    },
    {
      "path": "apps/cmp/src/components/ui",
      "scope": "cmp",
      "kind": "app-wrapper"
    },
    {
      "path": "apps/cmp/src/components/reui",
      "scope": "cmp",
      "kind": "vendored-registry"
    },
    {
      "path": "apps/cmp/src/components",
      "scope": "cmp",
      "kind": "application-component"
    },
    {
      "path": "apps/tms/src/components/ui",
      "scope": "tms",
      "kind": "app-wrapper"
    },
    {
      "path": "apps/tms/src/components",
