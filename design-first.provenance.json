    },
    {
      "path": "apps/intranet/src/components/ui",
      "scope": "intranet",
      "kind": "app-wrapper"
    },
    {
      "path": "apps/intranet/src/components",
      "scope": "intranet",
      "kind": "application-component"
    },
    {
      "path": "apps/ib/src/components",
      "scope": "ib",
      "kind": "application-component"
    },
    {
      "path": "apps/ui-showroom/registry/new-york",
