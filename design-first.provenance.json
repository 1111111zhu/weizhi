    "apps/emp/src",
    "apps/cmp/src",
    "apps/tms/src",
    "apps/intranet/src",
    "apps/ib/src",
    "apps/ui-showroom"
  ],
  "tokenRoots": [
    "packages/ui/src",
    "apps/emp/src",
    "apps/cmp/src",
    "apps/tms/src",
    "apps/intranet/src",
    "apps/ib/src",
