model User {
  id                            String                            @id @default(cuid())
  email                         String                            @unique
  name                          String
  staffNo                       String?                           @unique @map("staff_no")
  hourlyRate                    Decimal?                          @map("hourly_rate") @db.Decimal(18, 2)
  emailVerified                 Boolean                           @default(true) @map("email_verified")
  image                         String?
  globalRole                    GlobalRole                        @map("global_role")
  status                        UserStatus                        @default(ACTIVE)
  preferredLocale               String                            @default("zh-CN") @map("preferred_locale")
  cmpCurrencyOrder              Json?                             @map("cmp_currency_order")
  mailConnection                UserMailConnection?
  systemConnectionsUpdated      SystemConnection[]                @relation("SystemConnectionUpdater")
  createdAt                     DateTime                          @default(now()) @map("created_at")
  updatedAt                     DateTime                          @updatedAt @map("updated_at")
  ownedWorkspaces               Workspace[]                       @relation("WorkspaceOwner")
  workspaceMembers              WorkspaceMember[]
  ownedProjects                 Project[]                         @relation("ProjectOwner")
  projectMembers                ProjectMember[]
  projectWorkspacePlacements    ProjectWorkspacePlacement[]
  desktopFolders                DesktopFolder[]                   @relation("DesktopFolderOwner")
  desktopProjectPlacements      DesktopProjectPlacement[]         @relation("DesktopPlacementUser")
  invitationsSent               ProjectInvitation[]               @relation("InvitationSender")
  inboxMessages                 InboxMessage[]                    @relation("InboxRecipient")
  sentInboxMessages             InboxMessage[]                    @relation("InboxSender")
  independenceDeclarations      IndependenceDeclaration[]
  workflowNodes                 WorkflowNode[]                    @relation("WorkflowNodeCreator")
  workingPapers                 WorkingPaper[]                    @relation("WorkingPaperCreator")
  preparedWorkingPapers         WorkingPaper[]                    @relation("WorkingPaperPreparer")
  reviewedWorkingPapers         WorkingPaper[]                    @relation("WorkingPaperReviewer")
  workingPaperSignoffs          WorkingPaperSignoff[]             @relation("WorkingPaperSignoffUser")
  revokedWorkingPaperSignoffs   WorkingPaperSignoff[]             @relation("WorkingPaperSignoffRevokedBy")
  reviewQuestionsAssigned       WorkingPaperQuestion[]            @relation("WorkingPaperQuestionAssignee")
  reviewQuestionsCreated        WorkingPaperQuestion[]            @relation("WorkingPaperQuestionCreator")
  reviewQuestionsReplied        WorkingPaperQuestion[]            @relation("WorkingPaperQuestionReplier")
  reviewQuestionsCleared        WorkingPaperQuestion[]            @relation("WorkingPaperQuestionClearer")
  reviewQuestionsReopened       WorkingPaperQuestion[]            @relation("WorkingPaperQuestionReopener")
  reviewQuestionMessages        WorkingPaperQuestionMessage[]     @relation("WorkingPaperQuestionMessageAuthor")
  cmpAcceptanceRequests         CmpAcceptanceRequest[]            @relation("CmpAcceptanceSubmitter")
  cmpMicAcceptanceRequests      CmpAcceptanceRequest[]            @relation("CmpAcceptanceMicApprover")
  cmpPicAcceptanceRequests      CmpAcceptanceRequest[]            @relation("CmpAcceptancePicApprover")
  cmpItAcceptanceRequests       CmpAcceptanceRequest[]            @relation("CmpAcceptanceItApprover")
  cmpAssignedAcceptanceDrafts   CmpAcceptanceRequest[]            @relation("CmpAcceptanceDraftAssignee")
  cmpCompletedAcceptanceDrafts  CmpAcceptanceRequest[]            @relation("CmpAcceptanceDraftCompleter")
  cmpAcceptanceApprovalSteps    CmpAcceptanceApprovalStep[]       @relation("CmpAcceptanceStepApprover")
  cmpClientsAsPartnerPic        CmpClient[]                       @relation("CmpClientPartnerPic")
  cmpClientsAsLeadingPartner    CmpClient[]                       @relation("CmpClientLeadingPartner")
  cmpClientsAsManagerMic        CmpClient[]                       @relation("CmpClientManagerMic")
  cmpClientsAsAlternativeMic    CmpClient[]                       @relation("CmpClientAlternativeMic")
  cmpEngagementsAsPic           CmpEngagement[]                   @relation("CmpEngagementPic")
  cmpEngagementsAsMic           CmpEngagement[]                   @relation("CmpEngagementMic")
  cmpEngagementsAsEqReviewer    CmpEngagement[]                   @relation("CmpEngagementEqReviewer")
  cmpEngagementFeePlanStaff     CmpEngagementFeePlanStaff[]       @relation("CmpEngagementFeePlanStaffUser")
  cmpBillingsCreated            CmpBilling[]                      @relation("CmpBillingCreator")
  cmpBillingsSubmitted          CmpBilling[]                      @relation("CmpBillingSubmitter")
  cmpBillingsApproved           CmpBilling[]                      @relation("CmpBillingApprover")
  cmpBillingsSent               CmpBilling[]                      @relation("CmpBillingSender")
  cmpBillingsClientPaid         CmpBilling[]                      @relation("CmpBillingClientPaidBy")
  cmpBillingsReconciled         CmpBilling[]                      @relation("CmpBillingReconciler")
  cmpBillingStatusEvents        CmpBillingStatusEvent[]           @relation("CmpBillingStatusEventActor")
  cmpBillingArtifactsUploaded   CmpBillingArtifact[]              @relation("CmpBillingArtifactUploader")
  cmpBillingFinanceReceipts     CmpBillingFinanceReceipt[]        @relation("CmpBillingFinanceReceiptCreator")
  cmpBillingFirmTemplatesCreated CmpBillingFirmTemplate[]         @relation("CmpBillingFirmTemplateCreator")
  cmpBillingFirmTemplatesUpdated CmpBillingFirmTemplate[]         @relation("CmpBillingFirmTemplateUpdater")
  cmpBillingBankTemplatesCreated CmpBillingBankTemplate[]         @relation("CmpBillingBankTemplateCreator")
  cmpBillingBankTemplatesUpdated CmpBillingBankTemplate[]         @relation("CmpBillingBankTemplateUpdater")
  cmpExchangeRateBatchesRefreshed CmpExchangeRateBatch[]          @relation("CmpExchangeRateBatchRefresher")
  cmpExchangeRateFallbacksUpdated CmpBudgetExchangeRateFallback[] @relation("CmpExchangeRateFallbackUpdater")
  cmpClientRelationshipsCreated CmpClientRelationship[]           @relation("CmpClientRelationshipCreator")
  cmpClientSearchDocuments      CmpClientSearchDocument[]         @relation("CmpClientSearchDocumentUploader")
  cmpAmlScreeningBatches          CmpAmlScreeningBatch[]            @relation("CmpAmlBatchTrigger")
  cmpAmlConfigurationUpdates     CmpAmlConfiguration[]             @relation("CmpAmlConfigurationUpdater")
  cmpAmlHitsReviewed              CmpAmlHit[]                       @relation("CmpAmlHitReviewer")
  attachments                   Attachment[]                      @relation("AttachmentUploader")
  preparedAttachments           Attachment[]                      @relation("AttachmentPreparer")
  reviewedAttachments           Attachment[]                      @relation("AttachmentReviewer")
  lockedAttachments             Attachment[]                      @relation("AttachmentLockHolder")
  deletedAttachments            Attachment[]                      @relation("AttachmentDeletedBy")
  restoredAttachments           Attachment[]                      @relation("AttachmentRestoredBy")
  lastModifiedAttachments       Attachment[]                      @relation("AttachmentLastModifier")
  archivedAttachmentVersions    AttachmentVersion[]               @relation("AttachmentVersionArchivedBy")
  uploadedAttachmentVersions    AttachmentVersion[]               @relation("AttachmentVersionUploader")
  desktopMasterGrants           DesktopMasterGrant[]
  zipMasterSessions             ZipMasterSession[]
  zipEntryMasterSessions        ZipEntryMasterSession[]
  projectArchiveArtifacts       ProjectArchiveArtifact[]          @relation("ProjectArchiveArtifactCreator")
  projectArchiveJobs            ProjectArchiveJob[]               @relation("ProjectArchiveJobCreator")
  projectFileExportJobs         ProjectFileExportJob[]            @relation("ProjectFileExportJobCreator")
  knowledgeDocumentsUploaded    KnowledgeDocument[]               @relation("KnowledgeDocumentUploader")
  smartFormTemplatesCreated     SmartFormTemplate[]               @relation("SmartFormTemplateCreator")
  smartFormTemplatesUpdated     SmartFormTemplate[]               @relation("SmartFormTemplateUpdater")
  smartFormTemplateVersions     SmartFormTemplateVersion[]        @relation("SmartFormTemplatePublisher")
  smartFormInstancesSaved       SmartFormInstance[]               @relation("SmartFormInstanceLastSaver")
  createdConfirmations          ProjectConfirmation[]             @relation("ProjectConfirmationCreator")
  responsibleConfirmations      ProjectConfirmation[]             @relation("ProjectConfirmationResponsible")
  confirmationLogisticsReadStates ConfirmationLogisticsReadState[]
  confirmationEmpImportJobs     ConfirmationEmpImportJob[]        @relation("ConfirmationEmpImportJobCreator")
  confirmationTemplatesUploaded ConfirmationTemplateLibraryFile[] @relation("ConfirmationTemplateLibraryUploader")
  confirmationResponsesUploaded ConfirmationResponseLibraryFile[] @relation("ConfirmationResponseLibraryUploader")
  confirmationResponsesRouted   ConfirmationResponseLibraryFile[] @relation("ConfirmationResponseLibraryRouter")
  auditLogs                     AuditLog[]                        @relation("AuditActor")
  authSessions                  AuthSession[]
  authAccounts                  AuthAccount[]
  tmsTimesheetMonths            TmsTimesheetMonth[]
  tmsPendingLinkSubmissions     TmsPendingLinkSubmission[]        @relation("TmsPendingLinkOwner")
  tmsProjectLinks               TmsProjectLink[]                  @relation("TmsProjectLinkOwner")

  @@map("users")
}

enum TmsTimesheetStatus {
  DRAFT
  SUBMITTED
  APPROVED
}

enum TmsApprovalStatus {
  NOT_SUBMITTED
  SUBMITTED
  APPROVED
  RETURNED
  PENDING_CONFIRMATION
}

enum TmsPendingLinkStatus {
  PENDING_LINK
  LINKED
  SUPERSEDED
}

enum TmsProjectLinkStatus {
  PENDING
  LINKED
}

enum TmsTimesheetHalf {
  FIRST_HALF
  SECOND_HALF
}

model TmsTimesheetMonth {
  id                      String             @id @default(cuid())
  userId                  String             @map("user_id")
  year                    Int
  month                   Int
  draftRows               Json               @default("[]") @map("draft_rows")
  firstStatus             TmsTimesheetStatus @default(DRAFT) @map("first_status")
  firstSubmittedRevision  Int                @default(0) @map("first_submitted_revision")
  firstSubmittedRows      Json?              @map("first_submitted_rows")
  firstApprovedById       String?            @map("first_approved_by_id")
  firstApprovedAt         DateTime?          @map("first_approved_at")
  secondStatus            TmsTimesheetStatus @default(DRAFT) @map("second_status")
  secondSubmittedRevision Int                @default(0) @map("second_submitted_revision")
  secondSubmittedRows     Json?              @map("second_submitted_rows")
  secondApprovedById      String?            @map("second_approved_by_id")
  secondApprovedAt        DateTime?          @map("second_approved_at")
  createdAt               DateTime           @default(now()) @map("created_at")
  updatedAt               DateTime           @updatedAt @map("updated_at")
  user                    User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, year, month])
  @@index([year, month, firstStatus, secondStatus])
  @@map("tms_timesheet_months")
}

model TmsApprovalSubmission {
  id            String            @id @default(cuid())
  ownerUserId   String            @map("owner_user_id")
  engagementId  String            @map("engagement_id")
  projectId     String?           @map("project_id")
  year          Int
  month         Int
  half          TmsTimesheetHalf
  revision      Int
  status        TmsApprovalStatus @default(SUBMITTED)
  submittedRows Json              @map("submitted_rows")
  submittedAt   DateTime          @default(now()) @map("submitted_at")
  reviewedById  String?           @map("reviewed_by_id")
  reviewedAt    DateTime?         @map("reviewed_at")
  returnReason  String?           @map("return_reason")
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")
  project       Project?          @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@unique([ownerUserId, engagementId, projectId, year, month, half, revision])
  @@index([engagementId, year, month, half, status])
  @@index([projectId, year, month, half, status])
  @@index([ownerUserId, year, month, half])
  @@map("tms_approval_submissions")
}

model TmsPendingLinkSubmission {
  id                 String               @id @default(cuid())
  ownerUserId        String               @map("owner_user_id")
  projectId          String               @map("project_id")
  year               Int
  month              Int
  half               TmsTimesheetHalf
  revision           Int
  status             TmsPendingLinkStatus @default(PENDING_LINK)
  submittedRows      Json                 @map("submitted_rows")
  linkedEngagementId String?              @map("linked_engagement_id")
  linkedAt           DateTime?            @map("linked_at")
  createdAt          DateTime             @default(now()) @map("created_at")
  updatedAt          DateTime             @updatedAt @map("updated_at")
  owner              User                 @relation("TmsPendingLinkOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  project            Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  linkedEngagement   CmpEngagement?       @relation(fields: [linkedEngagementId], references: [id], onDelete: SetNull)

  @@unique([ownerUserId, projectId, year, month, half, revision])
  @@index([projectId, status])
  @@index([ownerUserId, year, month, half, status])
  @@map("tms_pending_link_submissions")
}

model TmsProjectLink {
  id              String               @id @default(cuid())
  referenceNumber Int                  @unique @default(autoincrement()) @map("reference_number")
  ownerUserId     String               @map("owner_user_id")
  rowId           String               @map("row_id")
  year            Int
  month           Int
  periodScope     String               @map("period_scope")
  label           String
  projectId       String?              @map("project_id")
  status          TmsProjectLinkStatus @default(PENDING)
  createdAt       DateTime             @default(now()) @map("created_at")
  updatedAt       DateTime             @updatedAt @map("updated_at")
  owner           User                 @relation("TmsProjectLinkOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  project         Project?             @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@unique([ownerUserId, rowId])
  @@index([status, year, month])
  @@index([projectId, status])
  @@map("tms_project_links")
}

model AuthSession {
  id        String   @id @default(cuid())
  expiresAt DateTime @map("expires_at")
  token     String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("auth_sessions")
}

model AuthAccount {
  id                    String    @id @default(cuid())
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id")
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("auth_accounts")
}

model AuthVerification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([identifier])
  @@map("auth_verifications")
}

model AuthDeviceCode {
  id              String    @id @default(cuid())
  deviceCode      String    @unique @map("device_code")
  userCode        String    @unique @map("user_code")
  userId          String?   @map("user_id")
  expiresAt       DateTime  @map("expires_at")
  status          String
  lastPolledAt    DateTime? @map("last_polled_at")
  pollingInterval Int?      @map("polling_interval")
  clientId        String?   @map("client_id")
  scope           String?

  @@index([expiresAt])
  @@index([userId])
  @@map("auth_device_codes")
