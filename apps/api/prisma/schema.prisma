  description String
  createdAt   DateTime @default(now()) @map("created_at")
  actor       User     @relation("AuditActor", fields: [actorId], references: [id])
  project     Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([projectId, createdAt])
  @@map("audit_logs")
}

model KnowledgeDocument {
  id                String                        @id @default(cuid())
  referenceCode     String?                       @unique @map("reference_code")
  title             String
  department        String
  type              String
  secondaryCategory String?                       @map("secondary_category")
  tertiaryCategory  String?                       @map("tertiary_category")
  kind              String                        @default("FILE")
  body              Json?
  externalLink      String?                       @map("external_link")
  previewAllowed    Boolean                       @default(true) @map("preview_allowed")
  downloadAllowed   Boolean                       @default(true) @map("download_allowed")
  status            String                        @default("PUBLISHED")
  publishedAt       DateTime                      @default(now()) @map("published_at")
  archivedAt        DateTime?                     @map("archived_at")
  originalName      String?                       @map("original_name")
  objectKey         String?                       @unique @map("object_key")
  mimeType          String?                       @map("mime_type")
  size              Int?
  uploadedById      String                        @map("uploaded_by_id")
  createdAt         DateTime                      @default(now()) @map("created_at")
  updatedAt         DateTime                      @updatedAt @map("updated_at")
  uploader          User                          @relation("KnowledgeDocumentUploader", fields: [uploadedById], references: [id])
  attachments       KnowledgeDocumentAttachment[]

  @@index([department, secondaryCategory, tertiaryCategory, updatedAt])
  @@index([department, type, updatedAt])
  @@index([status, publishedAt])
  @@index([updatedAt])
  @@map("knowledge_documents")
}

model KnowledgeDocumentAttachment {
  id           String            @id @default(cuid())
  documentId   String            @map("document_id")
  originalName String            @map("original_name")
  objectKey    String            @unique @map("object_key")
  mimeType     String            @map("mime_type")
  size         Int
  createdAt    DateTime          @default(now()) @map("created_at")
  document     KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId, createdAt])
  @@map("knowledge_document_attachments")
}

model ConfirmationInformationLibraryEntry {
  requiresBankTemplate         Boolean  @default(false) @map("requires_bank_template")
  id                           String   @id @default(cuid())
  bankCode                     String   @unique @map("bank_code")
  bankNameEn                   String   @map("bank_name_en")
  bankNameZh                   String   @map("bank_name_zh")
  bankType                     String   @map("bank_type")
  businessAddress              String   @map("business_address")
  mailingAddress               String?  @map("mailing_address")
  mailingAddressSameAsBusiness Boolean  @default(false) @map("mailing_address_same_as_business")
  contactName                  String?  @map("contact_name")
  attention                    String?
  notes                        String?
  background                   String?
  historicalMailingAddress    String?  @map("historical_mailing_address")
  cautions                     String?
  sourceLabel                  String   @map("source_label")
  sourceRow                    Int?     @map("source_row")
  isActive                     Boolean  @default(true) @map("is_active")
  createdAt                    DateTime @default(now()) @map("created_at")
  updatedAt                    DateTime @updatedAt @map("updated_at")

  @@map("confirmation_information_library_entries")
}

model WorkItemRecord {
  id               String               @id @default(cuid())
  dedupeKey        String               @unique @map("dedupe_key")
  ruleId           String               @map("rule_id")
  cycleKey         String               @default("active") @map("cycle_key")
  domain           String
  subjectType      String               @map("subject_type")
  subjectId        String               @map("subject_id")
  projectId        String?              @map("project_id")
  status           WorkItemRecordStatus @default(ACTIVE)
  state            String
  severity         String
  priority         String
  locale           String               @default("zh-CN")
  displayContent   String               @map("display_content")
  contentKey       String               @map("content_key")
  contentParams    Json                 @map("content_params")
  actionTarget     Json                 @map("action_target")
  dueAt            DateTime?            @map("due_at")
  openedAt         DateTime             @map("opened_at")
  sourceUpdatedAt  DateTime             @map("source_updated_at")
  resolvedAt       DateTime?            @map("resolved_at")
  resolutionReason String?              @map("resolution_reason")
  createdAt        DateTime             @default(now()) @map("created_at")
  updatedAt        DateTime             @updatedAt @map("updated_at")
  responsibilities WorkItemResponsibility[]
  events           WorkItemEvent[]

  @@unique([ruleId, subjectType, subjectId, cycleKey])
  @@index([status, domain, updatedAt])
  @@index([projectId, status, updatedAt])
  @@map("work_item_records")
}

model WorkItemResponsibility {
  id           String                         @id @default(cuid())
  workItemId   String                         @map("work_item_id")
  selectorType WorkItemResponsibilitySelector @map("selector_type")
  selectorKey  String                         @map("selector_key")
  userId       String?                        @map("user_id")
  projectId    String?                        @map("project_id")
  roleCode     String?                        @map("role_code")
  engagementId String?                        @map("engagement_id")
  isPrimary    Boolean                        @default(false) @map("is_primary")
  createdAt    DateTime                       @default(now()) @map("created_at")
  workItem     WorkItemRecord                 @relation(fields: [workItemId], references: [id], onDelete: Cascade)

  @@unique([workItemId, selectorKey])
  @@index([selectorType, userId])
  @@index([selectorType, projectId])
  @@index([selectorType, roleCode])
  @@index([selectorType, engagementId])
  @@map("work_item_responsibilities")
}

model WorkItemEvent {
  id          String            @id @default(cuid())
  workItemId  String            @map("work_item_id")
  type        WorkItemEventType
  actorUserId String?           @map("actor_user_id")
  payload     Json?
  createdAt   DateTime          @default(now()) @map("created_at")
  workItem    WorkItemRecord    @relation(fields: [workItemId], references: [id], onDelete: Cascade)

  @@index([workItemId, createdAt])
  @@index([type, createdAt])
  @@map("work_item_events")
}
