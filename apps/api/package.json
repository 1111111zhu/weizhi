{
  "name": "@project-wing/api",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "dev": "node ../../scripts/dev-demo-api.mjs",
    "dev:preview-worker": "node ../../scripts/dev-demo-api.mjs preview-worker",
    "build": "nest build",
    "start": "node dist/main.js",
    "start:preview-worker": "node dist/preview-worker.main.js",
    "test": "corepack pnpm --filter @project-wing/shared build && vitest run",
    "test:ci": "vitest run",
    "lint": "tsc -p tsconfig.json --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev --name init",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "cmp:backfill-client-versions": "tsx prisma/backfill-cmp-client-versions.ts",
    "cmp:seed-client-version-examples": "tsx prisma/seed-cmp-client-version-examples.ts",
    "prisma:seed": "tsx prisma/seed.ts",
    "prisma:seed:demo": "tsx prisma/seed-demo.ts",
    "confirmation:import-hk-banks": "tsx prisma/import-hk-bank-information-library.ts"
  },
  "dependencies": {
    "7zip-bin": "5.2.0",
    "@better-auth/prisma-adapter": "1.6.23",
    "@myriaddreamin/typst-ts-node-compiler": "0.7.0",
    "@nestjs/common": "^11.1.9",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.9",
    "@nestjs/platform-express": "^11.1.9",
    "@nestjs/schedule": "^6.1.3",
    "@pdf-lib/fontkit": "^1.1.1",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.2.0",
    "@project-wing/shared": "workspace:*",
    "ali-oss": "^6.23.0",
    "archiver": "7.0.1",
    "bcryptjs": "^3.0.3",
    "better-auth": "1.6.23",
    "docx": "9.5.1",
    "dotenv": "^17.4.2",
    "exceljs": "4.4.0",
    "express": "5.2.1",
    "jszip": "^3.10.1",
    "nodemailer": "^9.0.1",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.2.108",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "xlsx": "npm:@e965/xlsx@0.20.3",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.4.1",
    "@nestjs/cli": "^11.0.14",
    "@nestjs/schematics": "^11.0.9",
    "@nestjs/testing": "^11.1.9",
    "@types/ali-oss": "^6.23.3",
    "@types/archiver": "6.0.3",
    "@types/express": "^5.0.6",
    "@types/node": "^24.10.2",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.15.6",
    "@types/supertest": "^6.0.3",
    "@typescript/native": "npm:typescript@^7.0.2",
    "prisma": "^7.2.0",
    "supertest": "^7.1.4",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "vitest": "^4.0.15"
  }
}
