      "description": {
        "values": {
          "zh-CN": {
            "type": "doc",
            "version": 1,
            "content": [
              {
                "type": "paragraph",
                "id": "deferred-income-final-conclusion-description-zh",
                "content": [
                  {
                    "type": "text",
                    "text": "请依据已执行的审计工作完成最终结论；如存在例外事项，请在后续文本框中说明。"
                  }
                ]
              }
            ]
          },
          "en-US": {
            "type": "doc",
            "version": 1,
            "content": [
              {
                "type": "paragraph",
                "id": "deferred-income-final-conclusion-description-en",
                "content": [
                  {
                    "type": "text",
                    "text": "Complete the final conclusion based on the audit work performed. Describe any exceptions in the following field."
                  }
                ]
              }
            ]
          }
        }
      },
      "children": [
