  "children": [
    {
      "id": "deferred-income-audit-objectives",
      "kind": "content",
      "content": {
        "values": {
          "zh-CN": {
            "type": "doc",
            "version": 1,
            "content": [
              {
                "type": "heading",
                "id": "deferred-income-audit-objectives-zh-title",
                "level": 2,
                "content": [
                  {
                    "type": "text",
                    "text": "审计目标"
                  }
                ]
              },
              {
                "type": "orderedList",
                "id": "deferred-income-audit-objectives-zh-list",
                "items": [
                  {
                    "id": "deferred-income-audit-objectives-zh-item-1",
                    "content": [
                      {
                        "type": "paragraph",
                        "id": "deferred-income-audit-objectives-zh-item-1-paragraph",
                        "content": [
                          {
                            "type": "text",
                            "text": "确保递延收入已正确核算且记录完整。"
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "id": "deferred-income-audit-objectives-zh-item-2",
                    "content": [
                      {
                        "type": "paragraph",
                        "id": "deferred-income-audit-objectives-zh-item-2-paragraph",
                        "content": [
                          {
                            "type": "text",
                            "text": "确认递延收入所需披露均已作出，且相关信息已得到适当列报和说明。"
                          }
                        ]
                      }
                    ]
                  }
                ]
              }
            ]
          },
          "en-US": {
            "type": "doc",
            "version": 1,
            "content": [
              {
                "type": "heading",
                "id": "deferred-income-audit-objectives-en-title",
                "level": 2,
                "content": [
                  {
                    "type": "text",
                    "text": "Audit objectives"
                  }
                ]
              },
              {
                "type": "orderedList",
                "id": "deferred-income-audit-objectives-en-list",
                "items": [
                  {
                    "id": "deferred-income-audit-objectives-en-item-1",
                    "content": [
                      {
                        "type": "paragraph",
                        "id": "deferred-income-audit-objectives-en-item-1-paragraph",
                        "content": [
                          {
                            "type": "text",
                            "text": "Ensure that deferred income has been correctly accounted for and is complete."
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "id": "deferred-income-audit-objectives-en-item-2",
                    "content": [
                      {
                        "type": "paragraph",
                        "id": "deferred-income-audit-objectives-en-item-2-paragraph",
                        "content": [
                          {
                            "type": "text",
                            "text": "Confirm that all necessary disclosures concerning deferred income have been made and that the information is appropriately presented and described."
                          }
                        ]
                      }
                    ]
                  }
                ]
              }
            ]
          }
        }
      }
    },
    {
      "id": "deferred-income-general",
      "kind": "section",
      "title": {
        "values": {
          "zh-CN": {
            "type": "doc",
            "version": 1,
            "content": [
              {
                "type": "paragraph",
                "id": "deferred-income-general-title-zh",
                "content": [
                  {
                    "type": "text",
                    "text": "一般审计程序"
                  }
                ]
              }
            ]
          },
          "en-US": {
            "type": "doc",
            "version": 1,
            "content": [
              {
                "type": "paragraph",
                "id": "deferred-income-general-title-en",
                "content": [
                  {
                    "type": "text",
                    "text": "General"
                  }
                ]
              }
            ]
          }
        }
      },
      "children": [
        {
          "id": "deferred-income-general-procedures",
          "kind": "component",
          "componentId": "audit-procedure-sheet",
          "componentVersion": 1,
          "props": {
            "procedures": [
              {
                "id": "deferred-income-procedure-1",
                "role": "data",
                "label": {
                  "values": {
                    "zh-CN": {
                      "type": "doc",
                      "version": 1,
                      "content": [
                        {
                          "type": "paragraph",
                          "id": "deferred-income-procedure-1-label-zh",
                          "content": [
                            {
                              "type": "text",
                              "text": "取得并检查（或编制）本年度数据主表，并与总账核对。"
                            }
                          ]
                        }
                      ]
                    },
                    "en-US": {
                      "type": "doc",
                      "version": 1,
                      "content": [
                        {
                          "type": "paragraph",
                          "id": "deferred-income-procedure-1-label-en",
                          "content": [
                            {
                              "type": "text",
                              "text": "Obtain and check, or prepare, a lead schedule for the current year’s figures and reconcile this to the general ledger."
                            }
                          ]
                        }
                      ]
                    }
                  }
                }
              },
              {
                "id": "deferred-income-procedure-2",
                "role": "group",
                "label": {
                  "values": {
                    "zh-CN": {
                      "type": "doc",
                      "version": 1,
                      "content": [
                        {
                          "type": "paragraph",
                          "id": "deferred-income-procedure-2-label-zh",
                          "content": [
                            {
                              "type": "text",
                              "text": "执行分析程序，例如："
                            }
                          ]
                        }
                      ]
                    },
                    "en-US": {
                      "type": "doc",
                      "version": 1,
                      "content": [
                        {
                          "type": "paragraph",
                          "id": "deferred-income-procedure-2-label-en",
                          "content": [
                            {
                              "type": "text",
                              "text": "Carry out analytical procedures such as:"
                            }
                          ]
                        }
                      ]
                    }
                  }
                },
                "children": [
                  {
                    "id": "deferred-income-procedure-2-a",
                    "role": "data",
                    "label": {
                      "values": {
                        "zh-CN": {
                          "type": "doc",
                          "version": 1,
                          "content": [
                            {
                              "type": "paragraph",
                              "id": "deferred-income-procedure-2-a-label-zh",
                              "content": [
                                {
                                  "type": "text",
                                  "text": "将本期数据与以前期间数据进行比较；"
                                }
                              ]
                            }
                          ]
                        },
                        "en-US": {
                          "type": "doc",
                          "version": 1,
                          "content": [
                            {
                              "type": "paragraph",
                              "id": "deferred-income-procedure-2-a-label-en",
                              "content": [
                                {
                                  "type": "text",
                                  "text": "Compare the current figures with those of prior periods;"
                                }
                              ]
                            }
                          ]
                        }
                      }
                    }
                  },
                  {
                    "id": "deferred-income-procedure-2-b",
                    "role": "data",
                    "label": {
                      "values": {
                        "zh-CN": {
                          "type": "doc",
                          "version": 1,
                          "content": [
                            {
                              "type": "paragraph",
                              "id": "deferred-income-procedure-2-b-label-zh",
                              "content": [
                                {
                                  "type": "text",
                                  "text": "复核并比较关键比率或其他绩效指标。"
                                }
                              ]
                            }
                          ]
                        },
                        "en-US": {
                          "type": "doc",
                          "version": 1,
                          "content": [
                            {
                              "type": "paragraph",
                              "id": "deferred-income-procedure-2-b-label-en",
                              "content": [
                                {
                                  "type": "text",
                                  "text": "Review and compare key ratios or other performance indicators."
                                }
                              ]
                            }
                          ]
                        }
                      }
                    }
                  }
                ]
              },
              {
                "id": "deferred-income-procedure-3",
                "role": "data",
                "label": {
                  "values": {
                    "zh-CN": {
                      "type": "doc",
                      "version": 1,
                      "content": [
                        {
                          "type": "paragraph",
                          "id": "deferred-income-procedure-3-label-zh",
                          "content": [
                            {
                              "type": "text",
                              "text": "复核超过执行重要性水平或其他异常的项目，并进行验证。"
                            }
                          ]
                        }
                      ]
                    },
                    "en-US": {
                      "type": "doc",
                      "version": 1,
                      "content": [
                        {
                          "type": "paragraph",
                          "id": "deferred-income-procedure-3-label-en",
                          "content": [
                            {
                              "type": "text",
                              "text": "Review for items above performance materiality or that are otherwise unusual and verify."
                            }
                          ]
                        }
                      ]
                    }
                  }
                }
              },
              {
                "id": "deferred-income-procedure-4",
                "role": "group",
                "label": {
                  "values": {
                    "zh-CN": {
                      "type": "doc",
                      "version": 1,
                      "content": [
                        {
                          "type": "paragraph",
                          "id": "deferred-income-procedure-4-label-zh",
                          "content": [
                            {
                              "type": "text",
                              "text": "复核递延收入的递延基础："
                            }
                          ]
                        }
                      ]
                    },
                    "en-US": {
                      "type": "doc",
                      "version": 1,
                      "content": [
                        {
                          "type": "paragraph",
                          "id": "deferred-income-procedure-4-label-en",
                          "content": [
                            {
                              "type": "text",
                              "text": "Review the basis for deferring income:"
                            }
                          ]
                        }
                      ]
                    }
                  }
                },
                "children": [
                  {
                    "id": "deferred-income-procedure-4-a",
                    "role": "data",
                    "label": {
                      "values": {
                        "zh-CN": {
                          "type": "doc",
                          "version": 1,
                          "content": [
                            {
                              "type": "paragraph",
                              "id": "deferred-income-procedure-4-a-label-zh",
                              "content": [
                                {
                                  "type": "text",
                                  "text": "核对支持性文件；"
                                }
                              ]
                            }
                          ]
                        },
                        "en-US": {
                          "type": "doc",
                          "version": 1,
                          "content": [
                            {
                              "type": "paragraph",
                              "id": "deferred-income-procedure-4-a-label-en",
                              "content": [
                                {
                                  "type": "text",
                                  "text": "Vouch to supporting documents; and"
                                }
                              ]
                            }
                          ]
                        }
                      }
                    }
                  },
                  {
                    "id": "deferred-income-procedure-4-b",
                    "role": "data",
                    "label": {
                      "values": {
                        "zh-CN": {
                          "type": "doc",
                          "version": 1,
                          "content": [
                            {
                              "type": "paragraph",
                              "id": "deferred-income-procedure-4-b-label-zh",
                              "content": [
                                {
                                  "type": "text",
                                  "text": "确保该基础有效、完整，并已按照与上年度一致的方法及适用会计准则正确应用。"
                                }
                              ]
                            }
                          ]
                        },
                        "en-US": {
                          "type": "doc",
                          "version": 1,
                          "content": [
                            {
                              "type": "paragraph",
                              "id": "deferred-income-procedure-4-b-label-en",
                              "content": [
                                {
                                  "type": "text",
                                  "text": "Ensure that it is valid, complete and has been correctly and consistently applied with the prior year and applicable accounting standards."
                                }
                              ]
                            }
                          ]
                        }
                      }
                    }
                  }
                ]
              },
              {
                "id": "deferred-income-procedure-5",
                "role": "data",
                "label": {
                  "values": {
                    "zh-CN": {
                      "type": "doc",
                      "version": 1,
                      "content": [
                        {
                          "type": "paragraph",
                          "id": "deferred-income-procedure-5-label-zh",
                          "content": [
                            {
                              "type": "text",
                              "text": "确保被审计单位按照适用会计准则核算外币交易。"
                            }
                          ]
                        }
                      ]
                    },
                    "en-US": {
                      "type": "doc",
                      "version": 1,
                      "content": [
                        {
                          "type": "paragraph",
                          "id": "deferred-income-procedure-5-label-en",
                          "content": [
                            {
                              "type": "text",
                              "text": "Ensure the entity accounted for foreign currency transactions in accordance with applicable accounting standards."
                            }
                          ]
                        }
                      ]
                    }
                  }
                }
              },
              {
                "id": "deferred-income-procedure-6",
                "role": "data",
                "label": {
                  "values": {
                    "zh-CN": {
                      "type": "doc",
                      "version": 1,
                      "content": [
                        {
                          "type": "paragraph",
                          "id": "deferred-income-procedure-6-label-zh",
                          "content": [
                            {
                              "type": "text",
                              "text": "确认所有货币性负债均已按适当的期末汇率折算。"
                            }
                          ]
                        }
                      ]
                    },
                    "en-US": {
                      "type": "doc",
                      "version": 1,
                      "content": [
                        {
                          "type": "paragraph",
                          "id": "deferred-income-procedure-6-label-en",
                          "content": [
                            {
                              "type": "text",
                              "text": "Confirm that all monetary liabilities have been translated at an appropriate closing rate."
                            }
                          ]
                        }
                      ]
                    }
                  }
                }
              }
            ],
            "referenceTargetTypes": [
              "projectWing.workingPaper"
            ]
          }
        }
      ]
    },
    {
      "id": "deferred-income-presentation",
      "kind": "section",
      "title": {
        "values": {
          "zh-CN": {
            "type": "doc",
            "version": 1,
            "content": [
              {
                "type": "paragraph",
                "id": "deferred-income-presentation-title-zh",
                "content": [
                  {
                    "type": "text",
                    "text": "列报与披露"
                  }
                ]
              }
            ]
          },
          "en-US": {
            "type": "doc",
            "version": 1,
            "content": [
              {
                "type": "paragraph",
                "id": "deferred-income-presentation-title-en",
                "content": [
                  {
                    "type": "text",
                    "text": "Presentation and disclosure"
                  }
                ]
              }
            ]
          }
        }
      },
      "description": {
        "values": {
          "zh-CN": {
            "type": "doc",
            "version": 1,
            "content": [
              {
                "type": "paragraph",
                "id": "deferred-income-presentation-description-zh",
                "content": [
                  {
                    "type": "text",
                    "text": "评估递延收入相关列报和披露是否有充分、适当的审计证据支持。"
                  }
                ]
              }
            ]
          },
          "en-US": {
            "type": "doc",
            "version": 1,
            "content": [
              {
                "type": "paragraph",
                "id": "deferred-income-presentation-description-en",
                "content": [
                  {
                    "type": "text",
                    "text": "Evaluate whether the presentation and disclosures relating to deferred income are supported by sufficient appropriate audit evidence."
                  }
                ]
              }
            ]
          }
        }
      },
      "children": [
        {
          "id": "deferred-income-presentation-procedures",
          "kind": "component",
          "componentId": "audit-procedure-sheet",
          "componentVersion": 1,
          "props": {
            "procedures": [
              {
                "id": "deferred-income-procedure-7",
                "role": "data",
                "label": {
                  "values": {
                    "zh-CN": {
                      "type": "doc",
                      "version": 1,
                      "content": [
                        {
                          "type": "paragraph",
                          "id": "deferred-income-procedure-7-label-zh",
                          "content": [
                            {
                              "type": "text",
                              "text": "确保审计档案中有充分、适当的证据支持所有已作出的披露。"
                            }
                          ]
                        }
                      ]
                    },
                    "en-US": {
                      "type": "doc",
                      "version": 1,
                      "content": [
                        {
                          "type": "paragraph",
                          "id": "deferred-income-procedure-7-label-en",
                          "content": [
                            {
                              "type": "text",
                              "text": "Ensure that there is sufficient appropriate evidence on the file to support all disclosures made."
                            }
                          ]
                        }
                      ]
                    }
                  }
                }
              }
            ],
            "referenceTargetTypes": [
              "projectWing.workingPaper"
            ]
          }
        }
      ]
    },
    {
      "id": "deferred-income-bespoke",
      "kind": "section",
      "title": {
        "values": {
          "zh-CN": {
            "type": "doc",
            "version": 1,
            "content": [
              {
                "type": "paragraph",
                "id": "deferred-income-bespoke-title-zh",
                "content": [
                  {
                    "type": "text",
                    "text": "定制测试"
                  }
                ]
              }
            ]
          },
          "en-US": {
            "type": "doc",
            "version": 1,
            "content": [
              {
                "type": "paragraph",
                "id": "deferred-income-bespoke-title-en",
                "content": [
                  {
                    "type": "text",
                    "text": "Bespoke tests"
                  }
                ]
              }
            ]
          }
        }
      },
      "description": {
        "values": {
          "zh-CN": {
            "type": "doc",
            "version": 1,
            "content": [
              {
                "type": "paragraph",
                "id": "deferred-income-bespoke-description-zh",
                "content": [
                  {
                    "type": "text",
                    "text": "记录并执行因本项目具体情况而需要的额外审计程序。"
                  }
                ]
              }
            ]
          },
          "en-US": {
            "type": "doc",
            "version": 1,
            "content": [
              {
                "type": "paragraph",
                "id": "deferred-income-bespoke-description-en",
                "content": [
                  {
                    "type": "text",
                    "text": "Document and perform additional audit procedures required by the specific circumstances of the engagement."
                  }
                ]
              }
            ]
          }
        }
      },
      "children": [
        {
          "id": "deferred-income-bespoke-procedures",
          "kind": "component",
          "componentId": "audit-procedure-sheet",
          "componentVersion": 1,
          "props": {
            "procedures": [
              {
                "id": "deferred-income-procedure-8",
                "role": "data",
                "label": {
                  "values": {
                    "zh-CN": {
                      "type": "doc",
                      "version": 1,
                      "content": [
                        {
                          "type": "paragraph",
                          "id": "deferred-income-procedure-8-label-zh",
                          "content": [
                            {
                              "type": "text",
                              "text": "如有需要，设计并执行必要的额外测试，并与相关工作底稿中的审计目标相互索引。"
                            }
                          ]
                        }
                      ]
                    },
                    "en-US": {
                      "type": "doc",
                      "version": 1,
                      "content": [
                        {
                          "type": "paragraph",
                          "id": "deferred-income-procedure-8-label-en",
                          "content": [
                            {
                              "type": "text",
                              "text": "Draft and perform any necessary additional tests if required and cross reference with the objectives on the relevant working paper."
                            }
                          ]
                        }
                      ]
                    }
                  }
                }
              }
            ],
            "referenceTargetTypes": [
              "projectWing.workingPaper"
            ]
          }
        }
      ]
    },
    {
      "id": "deferred-income-conclusion",
      "kind": "section",
      "title": {
        "values": {
          "zh-CN": {
