          "help": {
            "values": {
              "zh-CN": {
                "type": "doc",
                "version": 1,
                "content": [
                  {
                    "type": "paragraph",
                    "id": "deferred-income-final-conclusion-help-zh",
                    "content": [
                      {
                        "type": "text",
                        "text": "根据已执行的审计工作，我确认：已按照审计程序执行工作；已充分记录所执行的工作及取得的结果；已收集财务报表列报与披露所需的全部资料；已取得充分、适当的证据支持所达成的审计结论；并且在我看来，递延收入已得到公允列报（如未公允列报，请在下方说明）。"
                      }
                    ]
                  }
                ]
              },
              "en-US": {
                "type": "doc",
                "version": 1,
                "content": [
                  {
                    "type": "paragraph",
                    "id": "deferred-income-final-conclusion-help-en",
                    "content": [
                      {
                        "type": "text",
                        "text": "From the audit work carried out, I confirm that: the work has been performed in accordance with the audit programme; the work performed and results obtained have been adequately documented; all necessary information has been collected for presentation and disclosure in the financial statements; sufficient appropriate evidence has been obtained to support the audit conclusion reached; and, in my opinion, deferred income is fairly stated (if not, describe below)."
                      }
                    ]
                  }
                ]
              }
            }
          },
          "value": {
