                  {
                    "type": "text",
                    "text": "结论程序"
                  }
                ]
              }
            ]
          },
          "en-US": {
            "type": "doc",
            "version": 1,
            "content": [
              {
                "type": "paragraph",
                "id": "deferred-income-conclusion-title-en",
                "content": [
                  {
                    "type": "text",
                    "text": "Conclusion"
                  }
                ]
              }
            ]
          }
        }
      },
      "description": {
        "values": {
          "zh-CN": {
            "type": "doc",
            "version": 1,
            "content": [
              {
                "type": "paragraph",
                "id": "deferred-income-conclusion-description-zh",
                "content": [
                  {
                    "type": "text",
                    "text": "完成递延收入审计程序的收尾评估。"
                  }
                ]
              }
            ]
          },
          "en-US": {
            "type": "doc",
            "version": 1,
            "content": [
              {
                "type": "paragraph",
                "id": "deferred-income-conclusion-description-en",
                "content": [
                  {
                    "type": "text",
                    "text": "Complete the closing assessment for the deferred income audit programme."
                  }
                ]
              }
            ]
          }
        }
      },
      "children": [
        {
          "id": "deferred-income-conclusion-procedures",
          "kind": "component",
          "componentId": "audit-procedure-sheet",
          "componentVersion": 1,
          "props": {
            "procedures": [
              {
                "id": "deferred-income-procedure-9",
                "role": "data",
                "label": {
                  "values": {
                    "zh-CN": {
                      "type": "doc",
                      "version": 1,
                      "content": [
                        {
                          "type": "paragraph",
                          "id": "deferred-income-procedure-9-label-zh",
                          "content": [
                            {
                              "type": "text",
                              "text": "考虑是否存在需要纳入管理层声明书或向治理层报告的事项，并作适当记录。"
                            }
                          ]
                        }
                      ]
                    },
                    "en-US": {
                      "type": "doc",
                      "version": 1,
                      "content": [
                        {
                          "type": "paragraph",
                          "id": "deferred-income-procedure-9-label-en",
                          "content": [
                            {
                              "type": "text",
                              "text": "Consider whether there are any points which need to be included in a letter of representation or report to those charged with governance and record as appropriate."
                            }
                          ]
                        }
                      ]
                    }
                  }
                }
              },
              {
                "id": "deferred-income-procedure-10",
                "role": "data",
                "label": {
                  "values": {
                    "zh-CN": {
                      "type": "doc",
                      "version": 1,
                      "content": [
                        {
                          "type": "paragraph",
                          "id": "deferred-income-procedure-10-label-zh",
                          "content": [
                            {
                              "type": "text",
                              "text": "复核本领域对内部控制的计划依赖程度，并考虑该依赖程度是否仍然适当。"
                            }
                          ]
                        }
                      ]
                    },
                    "en-US": {
                      "type": "doc",
                      "version": 1,
                      "content": [
                        {
                          "type": "paragraph",
                          "id": "deferred-income-procedure-10-label-en",
                          "content": [
                            {
                              "type": "text",
                              "text": "Review the planned extent of reliance on internal controls in this area and consider whether this remains appropriate."
                            }
                          ]
                        }
                      ]
                    }
                  }
                }
              },
              {
                "id": "deferred-income-procedure-11",
                "role": "data",
                "label": {
                  "values": {
                    "zh-CN": {
                      "type": "doc",
                      "version": 1,
                      "content": [
                        {
                          "type": "paragraph",
                          "id": "deferred-income-procedure-11-label-zh",
                          "content": [
                            {
                              "type": "text",
                              "text": "根据已取得的审计证据，评估是否应修订初始重要性水平和／或风险评估。记录任何必要调整的详情，并考虑其对剩余审计工作及截至目前已执行工作的影响。"
                            }
                          ]
                        }
                      ]
                    },
                    "en-US": {
                      "type": "doc",
                      "version": 1,
                      "content": [
                        {
                          "type": "paragraph",
                          "id": "deferred-income-procedure-11-label-en",
                          "content": [
                            {
                              "type": "text",
                              "text": "Assess whether the initial materiality and/or risk assessment should be revised in view of the audit evidence obtained. Record details of any necessary adjustments. Consider the impact on the remainder of the audit work and on any work undertaken to date."
                            }
                          ]
                        }
                      ]
                    }
                  }
                }
              }
            ],
            "referenceTargetTypes": [
              "projectWing.workingPaper"
            ]
          }
        }
      ]
    },
