{
  "name": "@project-wing/ui-showroom",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "test": "vitest run",
    "test:mobile": "vitest run components/showroom/specimens/mobile-workspace-model.test.ts components/showroom/specimens/mobile-services-model.test.ts components/showroom/specimens/mobile-settings-model.test.ts components/showroom/specimens/mobile-project-creation-model.test.ts components/showroom/specimens/mobile-preview-pdf.test.ts components/showroom/specimens/mobile-signoff-model.test.ts",
    "dev": "next dev -H 0.0.0.0 -p 3008",
    "build": "pnpm registry:build && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "registry:build": "node scripts/build-registry.mjs",
    "postinstall": "fumadocs-mdx",
    "check": "pnpm --dir ../.. exec oxfmt --config oxfmt.config.ts --check apps/ui-showroom && tsc --noEmit",
    "fix": "pnpm --dir ../.. exec oxfmt --config oxfmt.config.ts apps/ui-showroom",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@project-wing/document-viewer": "workspace:*",
    "@project-wing/pdf-template-designer": "workspace:*",
    "@project-wing/shared": "workspace:*",
    "@project-wing/ui": "workspace:*",
    "@vercel/analytics": "^2.0.1",
    "@web-kits/audio": "^0.1.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "fumadocs-core": "^16.8.4",
    "fumadocs-mdx": "^14.3.1",
    "jiti": "^2.6.1",
    "jotai": "^2.19.1",
    "lru-cache": "^11.3.5",
    "lucide-react": "1.11.0",
    "motion": "^12.38.0",
    "next": "^16.3.0",
    "next-themes": "0.4.6",
    "pdf-lib": "^1.17.1",
    "postcss": "^8.5.10",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-hotkeys-hook": "^5.2.4",
    "rehype-pretty-code": "^0.14.3",
    "shiki": "^4.0.2",
    "sonner": "^2.0.7",
