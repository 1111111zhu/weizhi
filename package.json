{
  "name": "project-wing",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "local:all": "node scripts/dev-local.mjs",
    "local:api": "corepack pnpm --filter @project-wing/api dev",
    "local:preview-worker": "corepack pnpm --filter @project-wing/api dev:preview-worker",
    "local:emp": "node scripts/dev-app.mjs emp local",
    "mock:emp": "node scripts/dev-app.mjs emp mock",
    "local:cmp": "node scripts/dev-app.mjs cmp local",
    "mock:cmp": "node scripts/dev-app.mjs cmp mock",
    "local:tms": "node scripts/dev-app.mjs tms local",
    "mock:tms": "node scripts/dev-app.mjs tms mock",
    "local:intranet": "node scripts/dev-app.mjs intranet local",
    "mock:intranet": "node scripts/dev-app.mjs intranet mock",
    "local:ib": "node scripts/dev-app.mjs ib local",
    "local:ib-api": "corepack pnpm --filter @project-wing/ib-api dev",
    "build": "corepack pnpm -r build",
    "check": "ultracite check",
    "fix": "ultracite fix && oxfmt --config oxfmt.config.ts .",
    "format": "ultracite fix && oxfmt --config oxfmt.config.ts .",
    "format:check": "ultracite check",
    "format:dotnet": "node scripts/format-dotnet.mjs --all",
    "format:dotnet:check": "node scripts/format-dotnet.mjs --all --check",
    "test": "node scripts/volatile-test-assertions.mjs && node scripts/run-workspace-tests.mjs",
    "hooks:doctor": "node scripts/hooks-doctor.mjs",
    "test:precommit": "node scripts/pre-commit-selective-tests.mjs",
    "test:precommit:logic": "node --test scripts/commitlint-config.test.mjs scripts/commit-message-guard.test.mjs scripts/hooks-doctor.test.mjs scripts/no-python-policy.test.mjs scripts/pre-commit-selective-tests.test.mjs scripts/pre-push-guard.test.mjs scripts/repository-policy-guardrails.test.mjs scripts/run-workspace-tests.test.mjs",
    "test:repository-policy": "node --test scripts/commitlint-config.test.mjs scripts/commit-message-guard.test.mjs scripts/hooks-doctor.test.mjs scripts/no-python-policy.test.mjs scripts/pre-push-guard.test.mjs scripts/repository-policy-guardrails.test.mjs",
    "test:ui-stack": "node scripts/ui-stack-guardrails.mjs && node scripts/volatile-test-assertions.mjs",
    "test:ui-stack:logic": "node --test scripts/ui-stack-baseline-monotonic.test.mjs scripts/ui-stack-guardrails.test.mjs scripts/volatile-test-assertions.test.mjs scripts/design-first/*.test.mjs",
    "lint": "corepack pnpm lint:ox && corepack pnpm typecheck",
    "lint:ox": "ultracite check",
    "typecheck": "corepack pnpm --filter @project-wing/shared build && corepack pnpm -r lint",
    "db:generate": "corepack pnpm --filter @project-wing/api prisma:generate",
    "db:migrate": "corepack pnpm --filter @project-wing/api prisma:migrate",
    "db:seed": "corepack pnpm --filter @project-wing/api prisma:seed",
    "db:seed:demo": "corepack pnpm --filter @project-wing/api prisma:seed:demo",
    "demo:setup": "node scripts/setup-demo-db.mjs",
    "build:desktop-agent:win": "corepack pnpm --filter @project-wing/desktop-agent-desktop package:windows",
    "build:desktop-agent:mac": "corepack pnpm --filter @project-wing/desktop-agent-desktop package:macos",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@typescript/typescript-win32-x64": "7.0.2",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "next": "^16.3.0",
    "oxfmt": "^0.62.0",
    "oxlint": "^1.79.0",
    "playwright-core": "^1.60.0",
    "shadcn": "4.18.0",
    "typescript": "^6.0.3",
    "ultracite": "^7.10.6"
  },
  "packageManager": "pnpm@11.5.0"
}
