DATABASE_URL="postgresql://projectwing:projectwing@localhost:5432/projectwing_demo?schema=public"
BETTER_AUTH_SECRET="replace-with-a-long-random-secret"
BETTER_AUTH_URL="http://localhost:3000"
BETTER_AUTH_TRUSTED_ORIGINS="http://localhost:3001,http://localhost:3002,http://localhost:3003,http://localhost:3007"
# BETTER_AUTH_COOKIE_DOMAIN=".superfx.cn"
PROJECT_WING_MAIL_CREDENTIAL_KEY="replace-with-32-byte-base64-or-64-char-hex-key"
FRONTEND_URL="http://localhost:3001"
PROJECTWING_CMP_URL="http://localhost:3002"
# Optional system SMTP for EMP archive and CMP workflow notifications.
PROJECT_WING_SMTP_HOST=""
PROJECT_WING_SMTP_PORT="587"
PROJECT_WING_SMTP_USER=""
PROJECT_WING_SMTP_PASS=""
PROJECT_WING_SMTP_FROM=""
PROJECT_WING_SMTP_SECURE="false"
API_PORT=3000
STORAGE_DRIVER="local"
UPLOAD_DIR=".local/projectwing-demo/uploads"
OSS_REGION="oss-cn-shenzhen"
OSS_BUCKET="superfx-project-wing-files"
OSS_ENDPOINT="https://oss-cn-shenzhen.aliyuncs.com"
OSS_INTERNAL_ENDPOINT="https://oss-cn-shenzhen-internal.aliyuncs.com"
OSS_USE_INTERNAL_ENDPOINT="false"
OSS_ACCESS_KEY_ID=""
OSS_ACCESS_KEY_SECRET=""
OSS_SIGNED_URL_TTL_SECONDS=300
# Desktop Agent 直传凭证应覆盖弱网下单次分片的重试窗口。
OSS_DESKTOP_TRANSFER_URL_TTL_SECONDS=3600
# 小于该值使用单次签名 PUT；更大的文件使用 OSS Multipart Upload。
OSS_DESKTOP_MULTIPART_THRESHOLD_BYTES=33554432
# OSS 分片大小；服务会自动增大以保证分片总数不超过 10000。
OSS_DESKTOP_MULTIPART_PART_SIZE_BYTES=8388608
GOTENBERG_URL="http://localhost:3002"
CMP_DEFAULT_IT_APPROVER_ID=""

# Didit standalone AML screening. Keep the API key on the API server only.
PROJECT_WING_DIDIT_AML_ENABLED="false"
PROJECT_WING_DIDIT_API_KEY=""
PROJECT_WING_DIDIT_BASE_URL="https://verification.didit.me"
PROJECT_WING_DIDIT_TIMEOUT_MS="30000"
