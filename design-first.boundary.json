{
  "$schema": "./.design-first/assets/design-first-boundary.schema.json",
  "schemaVersion": 1,
  "scanRoots": [
    "apps/emp/src",
    "apps/cmp/src",
    "apps/tms/src",
    "apps/intranet/src",
    "apps/ib/src",
    "apps/ui-showroom"
  ],
  "designSystemRoots": [
    "packages/ui/src",
    "apps/emp/src/components/ui",
    "apps/emp/src/components/reui",
    "apps/emp/src/components/extend/ui",
    "apps/cmp/src/components/ui",
    "apps/cmp/src/components/reui",
    "apps/tms/src/components/ui",
    "apps/intranet/src/components/ui",
    "apps/ui-showroom/components/ui",
    "apps/ui-showroom/registry/new-york",
    "apps/ui-showroom/styles"
  ],
  "showroomChromeRoots": ["apps/ui-showroom/components"],
  "excludeGlobs": [
    "**/node_modules/**",
    "apps/ui-showroom/.next/**",
    "apps/ui-showroom/.source/**",
    "apps/ui-showroom/public/**",
    "apps/ui-showroom/registry/**",
    "**/dist/**",
    "**/build/**",
    "**/coverage/**",
    "**/*.test.*",
    "**/*.spec.*",
    "**/*.d.ts"
  ],
  "fileExtensions": [
    ".js",
    ".jsx",
    ".ts",
    ".tsx",
    ".css",
    ".scss",
    ".sass",
    ".less"
  ],
  "publicImports": ["@project-wing/ui"],
  "underlyingUiPackages": [
    "@base-ui/react",
    "@fluentui",
    "motion",
    "sonner",
    "@dnd-kit",
    "@embedpdf",
    "@extend-ai",
    "@glideapps/glide-data-grid",
    "@headless-tree",
    "@hugeicons",
    "@puckeditor/core",
    "@pdfme",
    "@tanstack/react-table",
    "@tiptap",
    "@xyflow/react",
    "border-beam",
    "class-variance-authority",
    "react-day-picker",
    "react-resizable-panels",
    "recharts"
  ],
  "nativeInteractiveTags": [
    "button",
    "input",
    "select",
    "textarea",
    "dialog",
    "table"
  ],
  "suspiciousComponentNames": [
    "Button",
    "IconButton",
    "Input",
    "Select",
    "Dialog",
    "Modal",
    "Popover",
    "Tooltip",
    "Toast",
    "Card",
    "Toolbar",
    "DataTable",
    "PageHeader",
    "AppShell"
  ],
  "rules": {
    "direct-ui-import": "warning",
    "design-system-deep-import": "warning",
    "relative-design-system-import": "warning",
    "native-interactive": "warning",
    "raw-color": "warning",
    "inline-style": "warning",
    "arbitrary-value": "warning",
    "local-reusable-ui": "warning"
  },
  "exceptions": []
}
